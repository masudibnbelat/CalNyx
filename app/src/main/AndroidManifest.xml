<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/AndroidManifest.xml -->
<!-- CLIPBOARD VERSION - replace your old AndroidManifest.xml with this. -->
<!-- Based on BLUEFILM-CAMERA (the full manifest you pasted 2026-11-06). -->
<!-- ONLY Clipboard changes, everything else byte-identical: -->
<!-- 1. NEW permission FOREGROUND_SERVICE_DATA_SYNC (Android 14+): -->
<!--    ClipboardService runs as foregroundServiceType="dataSync", -->
<!--    Android 14+ requires this permission for that type. -->
<!--    FOREGROUND_SERVICE / POST_NOTIFICATIONS / RECEIVE_BOOT_COMPLETED -->
<!--    were already declared, so they are NOT added again. -->
<!-- 2. NEW service .clipboard.ClipboardService (exported=false, -->
<!--    foregroundServiceType="dataSync") - listens for copies. -->
<!-- 3. NEW receiver .clipboard.ClipboardBootReceiver (exported=true, -->
<!--    BOOT_COMPLETED) - restarts the listener after reboot. -->
<!-- BlueFilm camera, ball, orientation, WhatsApp, AppLock - all kept. -->
<!-- BLUEFILM-CAMERA VERSION - replace your old AndroidManifest.xml with this. -->
<!-- Based on WHATSAPP. New vs BLUEFILM (screen recorder): -->
<!-- BlueFilmService is now a CAMERA video recorder (front / back -->
<!-- camera, Camera2 + MediaRecorder), NOT a screen recorder. -->
<!-- - foregroundServiceType="camera" (was "mediaProjection") -->
<!-- - FOREGROUND_SERVICE_CAMERA added -->
<!-- V3: WAKE_LOCK added, so Blue Film keeps recording when -->
<!-- the screen turns off / locks. -->
<!-- - FOREGROUND_SERVICE_MEDIA_PROJECTION removed (nothing uses -->
<!--   MediaProjection any more) -->
<!-- - CAMERA permission was already declared, kept as-is. -->
<!-- - Camera features added with required="false" so phones -->
<!--   without a front camera still install. -->
<!-- - The duplicate FileProvider block (same authorities, listed -->
<!--   twice) is removed - only one copy is kept. -->
<!-- Based on PANEL7. Only changes: declares OrientationService -->
<!-- (foreground service that enforces the orientation lock with -->
<!-- a 0x0 overlay, so 180 deg holds outside the app) and -->
<!-- OrientationBootReceiver (restores a locked mode after -->
<!-- reboot). No new permissions: RECEIVE_BOOT_COMPLETED, -->
<!-- FOREGROUND_SERVICE_SPECIAL_USE and SYSTEM_ALERT_WINDOW -->
<!-- are already declared. -->
<!-- Based on PANEL6. Only change: CALL_PHONE REMOVED. The direct -->
<!-- dial (ACTION_CALL) placed a REAL call to *#*#4636#*#* on this -->
<!-- realme instead of opening Phone info, so it is gone. The -->
<!-- Network Switcher now uses the secret-code broadcast instead, -->
<!-- which needs no permission. -->
<!-- Based on PANEL3. Only change: BallPanelActivity gets its own -->
<!-- taskAffinity, so it runs in a SEPARATE task from the app. -->
<!-- Closing the panel then returns to the app you were in, -->
<!-- never to CalNyx. The ball itself never opens the app. -->
<!-- Based on FIXED2, only Moan Control additions: -->
<!-- SYSTEM_ALERT_WINDOW (floating ball), MODIFY_AUDIO_SETTINGS -->
<!-- (sound sliders), VIBRATE, WRITE_SETTINGS (orientation), -->
<!-- ACCESS_NOTIFICATION_POLICY (Silent ringer), READ_PHONE_STATE -->
<!-- (Phone info fallback - IMEI/IMSI are blocked on Android 10+ -->
<!-- for normal apps, do not expect them), FOREGROUND_SERVICE_ -->
<!-- SPECIAL_USE (ball service, API 34+). -->
<!-- Changes vs UPDATED (only these, everything else same): -->
<!-- 1. POST_NOTIFICATIONS (Android 13+) - needed if you later show a -->
<!--    foreground notification to keep AppLock alive on Realme/Oppo. -->
<!-- 2. FOREGROUND_SERVICE + RECEIVE_BOOT_COMPLETED - lets the service -->
<!--    survive reboot / OEM kill on Android 14-17. No foreground service -->
<!--    is started yet, these are only declarations for that path. -->
<!-- 3. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS - lets AppLockScreen ask -->
<!--    the user to disable battery optimisation (Realme kills the -->
<!--    AccessibilityService otherwise). -->
<!-- 4. Your minSdk 26 / targetSdk 35 already covers Android 9 (28) -->
<!--    through 16/17 by compatibility. Do NOT raise minSdk. Target 36 -->
<!--    is only needed later for Play Store, when SDK 36 is installed. -->
<!-- + LOCKED-APP NOTIFICATIONS (2026-11-07): NEW service -->
<!--   .applock.LockedAppNotificationService - hides notifications -->
<!--   from locked apps. No new uses-permission needed -->
<!--   (BIND_NOTIFICATION_LISTENER_SERVICE is a service-level -->
<!--   permission). The user must still grant Notification access -->
<!--   in Settings, or the service never runs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Auto update check: lets the app see whether WiFi / mobile
         data is up. Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- CLIPBOARD (NEW): Android 14+ needs this for dataSync type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- SPY MIC (2026-11-07): Spy videos record microphone audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Vault: media read (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Vault: media read (Android 9-12) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Vault: delete from gallery (Android 9 only, 10+ needs no permission) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- App Lock: list launchable apps without QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CalNyxApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalNyx">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CalNyx"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Ball mini panel: transparent Compose Activity. It is
             NOT a launcher activity, so exported=false. -->
        <activity
            android:name=".moan.BallPanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="com.calnyx.app.ballpanel"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Moan Control: floating ball foreground service -->
        <service
            android:name=".moan.FloatingBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating ball for quick access to CalNyx controls" />
        </service>

        <!-- Moan Control: orientation lock foreground service.
             Enforces Up (0 deg) / Down (180 deg) outside the app
             with a 0x0 overlay. Runs only while a locked mode is
             active; stops itself in Auto. -->
        <service
            android:name=".moan.OrientationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforce and maintain screen rotation across system" />
        </service>

        <!-- Restore a locked orientation after reboot. -->
        <receiver
            android:name=".moan.OrientationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp opener: no UI. Receives a phone number tapped
             in any other app (Messenger, Phone, browser, ...) and
             opens that number's WhatsApp chat, then finishes.
             Exported so other apps can send it tel: intents. -->
        <activity
            android:name=".moan.WhatsAppOpenerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Blue Film camera video recorder: foreground service, so it
             keeps recording when the app is closed and the screen
             is locked. Not exported - only this app starts it. -->
        <service
            android:name=".BlueFilm.BlueFilmService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Clipboard (NEW): foreground service that listens for
             copies and saves them into Room. Not exported - only
             this app starts it. -->
        <service
            android:name=".clipboard.ClipboardService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Clipboard (NEW): restart the clipboard listener after
             a reboot, so auto-save resumes without opening the app. -->
        <receiver
            android:name=".clipboard.ClipboardBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Floating Ball (NEW): bring the ball back after a reboot,
             so it shows without opening the Hardware screen. -->
        <receiver
            android:name=".moan.BallBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- App Lock: AccessibilityService, must be enabled by user in Settings -->
        <service
            android:name=".applock.AppLockService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_lock_service_config" />
        </service>

        <!-- App Lock: hide notifications from locked apps (2026-11-07).
             The user must also grant Notification access (Settings >
             Apps > Special access > Notification access) or this
             service never runs. No new uses-permission needed. -->
        <service
            android:name=".applock.LockedAppNotificationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
